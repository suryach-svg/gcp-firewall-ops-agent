# Copy to firewall_ops_agent/.env (git-ignored) and fill in. Never commit real values.
# ADK loads <agent_dir>/.env automatically for `adk web` / `adk run`.

# --- Model backend (recommended: Gemini Enterprise Agent Platform with ADC, no API key) ---
GOOGLE_GENAI_USE_ENTERPRISE=true        # legacy equivalent: GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# Optional (developer API key mode only): read the key from Secret Manager at startup instead of .env
# GOOGLE_API_KEY_SECRET=projects/your-project-id/secrets/gemini-api-key/versions/latest

# --- Strategic model routing (long-term GA models, Nov 2026) ---
FAST_MODEL=gemini-3.8-flash
REASONING_MODEL=gemini-4-argon
LITE_MODEL=gemini-3.5-flash-lite
COMPLEX_INVENTORY_THRESHOLD=15

# --- Firewall data ---
FIREWALL_DATA_MODE=sample               # sample = bundled fictional org; live = read real rules via Compute API
ENABLE_LIVE_REMEDIATION=false           # true + live mode = approved changes are PATCHed to VPC rules
# ALLOWED_SCOPE_IDS=my-project-1,123456789012   # optional allowlist enforced by the guardrail plugin

# --- Sessions and memory ---
SESSION_DB_URL=sqlite+aiosqlite:///./.adk_data/sessions.db   # Cloud SQL: postgresql+asyncpg://...
MEMORY_BACKEND=sqlite                   # sqlite | vertex_memory_bank | in_memory | none
MEMORY_DB_PATH=./.adk_data/memory.db
# AGENT_ENGINE_ID=1234567890            # set after deploying to Agent Runtime (enables managed sessions + Memory Bank)
AGENT_ENGINE_LOCATION=us-central1       # Agent Runtime is regional (models above use the global endpoint)
COMPACTION_INTERVAL=4
COMPACTION_TOKEN_THRESHOLD=60000

# --- Observability and privacy ---
LOG_LEVEL=INFO
LOG_FORMAT=json                         # json (Cloud Logging) | text
ENABLE_CLOUD_TRACE=false                # export OpenTelemetry spans to Cloud Trace
ENABLE_CONSOLE_TRACE=false              # print spans locally
ENABLE_CLOUD_DLP=false                  # extra Sensitive Data Protection de-identification for memory
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false  # keep raw prompts/responses out of trace spans (true = local debugging only)
MAX_TOOL_CALLS_PER_INVOCATION=30
